# Application Port & Mode
VITE_APP_NAME="KHABAR"
VITE_APP_TAGLINE="Your Craving. Your Choice."
VITE_DEFAULT_LOCALE="en"
VITE_SUPPORTED_LOCALES="en,bn"

# API & Backend Services (if applicable)
VITE_API_BASE_URL="http://localhost:5173/api"

# Payment Gateway Public Keys (Public demo identifiers only)
VITE_BKASH_MERCHANT_NAME="KHABAR Food Delivery"
VITE_NAGAD_MERCHANT_NAME="KHABAR Food Delivery"

# Map & Geolocation configuration
VITE_DEFAULT_CITY="Dhaka"
