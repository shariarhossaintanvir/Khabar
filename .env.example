# ==============================================================================
# KHABAR — Production Security & Environment Configuration Template
# Tagline: "Your Craving. Your Choice."
# 
# Instructions:
# 1. Copy this file to .env.local for local development.
# 2. In staging/production environments, inject these variables via secure KMS / vault.
# 3. CRITICAL: Never commit .env, .env.local, or real production secrets to version control.
# ==============================================================================

# Application Configuration
VITE_APP_NAME="KHABAR"
VITE_APP_TAGLINE="Your Craving. Your Choice."
VITE_DEFAULT_LOCALE="en"
VITE_SUPPORTED_LOCALES="en,bn"
VITE_NODE_ENV="production"

# API & Gateway Configuration
VITE_API_BASE_URL="https://api.khabar.com.bd/v1"
VITE_ALLOWED_ORIGINS="https://khabar.com.bd,https://admin.khabar.com.bd,https://partner.khabar.com.bd"

# Cryptography & Password Hashing Configuration
# Client/Server PBKDF2 Iteration count (NIST SP 800-132 recommends >= 100,000 for SHA-256)
VITE_PBKDF2_ITERATIONS=100000
VITE_SESSION_EXPIRY_HOURS=24
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION_MINUTES=15

# Payment Gateway Configuration (MFS Bangladesh)
# Public Identifiers (Client-Safe)
VITE_BKASH_MERCHANT_NAME="KHABAR Food Delivery Ltd."
VITE_BKASH_MERCHANT_NUMBER="01700000000"
VITE_NAGAD_MERCHANT_NAME="KHABAR Food Delivery Ltd."
VITE_NAGAD_MERCHANT_NUMBER="01800000000"

# Server-Side Only Secrets (Do NOT prefix with VITE_ in production server environments)
# These are kept strictly on serverless/backend runtimes:
# BKASH_APP_KEY="bkash_app_key_placeholder"
# BKASH_APP_SECRET="bkash_app_secret_placeholder"
# BKASH_HMAC_SECRET="bkash_webhook_hmac_secret_sha256"
# NAGAD_PUBLIC_KEY="nagad_public_key_pem"
# NAGAD_PRIVATE_KEY="nagad_private_key_pem"
# JWT_SIGNING_KEY="cryptographically_random_256_bit_secret"

# Rate Limiting Configuration
VITE_RATE_LIMIT_LOGIN_MAX=5
VITE_RATE_LIMIT_LOGIN_WINDOW_SEC=60
VITE_RATE_LIMIT_ORDER_MAX=10
VITE_RATE_LIMIT_ORDER_WINDOW_SEC=60
VITE_RATE_LIMIT_COUPON_MAX=8
VITE_RATE_LIMIT_COUPON_WINDOW_SEC=60

# Audit Logging & Compliance
VITE_AUDIT_LOG_STORAGE_KEY="khabar_audit_logs_v1"
VITE_AUDIT_LOG_MAX_ENTRIES=500
VITE_AUDIT_LOG_LEVEL="INFO"

# Map & Geolocation configuration
VITE_DEFAULT_CITY="Dhaka"
VITE_DEFAULT_LAT=23.7925
VITE_DEFAULT_LNG=90.4078
