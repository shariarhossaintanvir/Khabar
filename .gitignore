# ==============================================================================
# KHABAR — Comprehensive Production Security & Environment Git Ignore
# Platform: KHABAR — Restaurant & Food Delivery Platform
# Standard: Zero-Trust Secrets Management & DevSecOps Hardened
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SENSITIVE CREDENTIALS, SECRETS & ENVIRONMENT FILES (NEVER COMMIT)
# ------------------------------------------------------------------------------
# Environment configuration containing database credentials, JWT keys, and API tokens
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local
.env.*
*.env
# Safe committed example templates (explicitly exempted)
!.env.example
!.env.template

# Secret vaults, keys and tokens
.secrets
.secrets.*
secrets.*
secret.*
*.secrets
*.vault

# ------------------------------------------------------------------------------
# 2. PRIVATE KEYS, CERTIFICATES & ASYMMETRIC CIPHERS
# ------------------------------------------------------------------------------
# Private keys, SSL/TLS certificates and keypairs
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.crt
*.cer
*.der
*.csr
*.keystore
*.jks
*.crl

# SSH private and public keys
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub
*.ppk
known_hosts
authorized_keys

# VPN & Tunnel credentials
*.ovpn

# ------------------------------------------------------------------------------
# 3. CLOUD, SERVICE PROVIDER & PAYMENT GATEWAY SECRETS
# ------------------------------------------------------------------------------
# GCP & Firebase Service Accounts
credentials.json
client_secret*.json
service-account*.json
google-services.json
GoogleService-Info.plist
.gcloud/
gcloud/

# AWS & Cloud Provider Credentials
.aws/
aws/credentials
aws/config

# Azure & Kubernetes Credentials
.azure/
.kube/
kubeconfig
kubeconfig.yaml
kubeconfig.yml
*.publishsettings

# Mobile Financial Services (MFS) & Payment Secrets
*bkash*.secret
*bkash*.key
*nagad*.key
*nagad*.secret
*stripe*.key
*stripe*.secret

# Authentication & CLI Tokens
.token
*.token
tokens.json
gh-token
github_token*
.git-credentials
.netrc

# Package Manager Auth Config (Prevents NPM / Yarn Publish Token Leaks)
.npmrc
.yarnrc
.yarnrc.yml

# ------------------------------------------------------------------------------
