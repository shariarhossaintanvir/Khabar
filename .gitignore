# ------------------------------------------------------------------------------
# SQLite, SQL dumps and database backups
*.sqlite
*.sqlite3
*.db
*.db3
*.s3db
*.sql
*.dump
*.rdb
*.sql.gz
*.sql.zip

# Exported audit logs and storage state dumps
audit_logs.json
audit_logs.csv
audit_logs/
audit-logs/
storage.json
local_storage.json
*.localstorage

